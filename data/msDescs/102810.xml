                           <origPlace>
                              <placeName ref="https://www.manuscripta.se/place/100081">Sverige</placeName>
                           </origPlace>, <origDate from="1868" to="1869">1868–1869</origDate>
                        </p>
                     </origin>
                  </history>
               </msPart>
