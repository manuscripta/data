                        <msContents>
                            <textLang mainLang="la"/>
                            <msItem>
                                <locus from="S1r" to="S25v" scheme="folios"/>
                                <title type="desc">Compactata Iglaviensia (the Jihlava compact)</title>
                                <rubric>Expositio Compactatorum quae Compactata habita sunt Iglaviae Marcomannorum Anno M CCCC XXXVI III Non.Julii. </rubric>
                                <msItem>
                                    <locus from="S1r" to="S1r" scheme="folios"/>
                                </msItem>
                                <msItem>
                                    <locus from="S11v" to="S11v" scheme="folios"/>
                                    <author>
                                        <persName ref="https://www.manuscripta.se/person/102794">
                                            Martin
                                            Lupáč </persName>
                                    </author>
                                    <title type="uniform">Response to Pius II</title>
                                    <rubric>Ad responsa Papae quae dedit nuncius Regis Georgii Anno 1462</rubric>
                                    <incipit>Primo ad illud vbi de Communione Euangelica vocalis Ecclesiae respondent, dicens Satis hic articulus in Concilio Basiliensi est discussus</incipit>
                                    <note>See <bibl>
                                            <title ref="https://www.manuscripta.se/bibl/107611" type="short">Veselá (2025)</title>
                                            <citedRange unit="page" from="186" to="187"/>
                                        </bibl>.</note>
                                </msItem>
                                <incipit>Cum fides Euangelica vniuersalis Ecclesiae</incipit>
                                <explicit>cum illa de qua subit dicens Necesse est Populum arcere a Communione Calicis</explicit>
                                <note> <locus from="S4r" to="S4r" scheme="folios"/>: Blank page. </note>
                                <bibl>
                                    <title ref="https://www.manuscripta.se/bibl/107546" type="short">Dudík (1852)</title>
                                    <citedRange unit="page" from="458" to="466"/>
                                    <note>about first half of the text</note>
                                </bibl>
                            </msItem>
                        </msContents>
