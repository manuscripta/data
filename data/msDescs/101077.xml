                            <decoDesc>
                                <p>Main text in brown ink. </p>
                                <decoNote type="initials">
                                    <p>Plain initials in red and blue, larger initials with pen-flourishing in contrasting colour.</p>
                                </decoNote>
                                <decoNote type="drawing">
                                    <p>In brown ink, <locus from="10r" to="10r" scheme="folios"/>: flower (?); <locus from="11r" to="11r" scheme="folios"/>: dove (sitting on the uppermost line of the staff). </p>
                                </decoNote>
                            </decoDesc>
